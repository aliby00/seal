# Copier vers .env.local et remplir. .env.local est gitignoré.
# Ne jamais mettre de vraie valeur dans ce fichier.

# Environnement : development | staging | production
SEAL_ENV=development

# Robinhood Chain — RPC (chain ID 4663)
# Public (rate-limité) : https://rpc.mainnet.chain.robinhood.com
RPC_URL=

# Blockscout — clé obligatoire, gratuite sur https://dev.blockscout.com
# Tier gratuit : 5 req/s, 100 000 crédits/jour
BLOCKSCOUT_API_KEY=

# Anthropic — https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# DexScreener ne demande aucune clé (300 req/min)
