# Copier vers .env.local et remplir. .env.local est gitignoré.
# Ne jamais mettre de vraie valeur dans ce fichier.

# Environnement : development | staging | production
SEAL_ENV=development

# Adresse publique du site (image de partage, lien canonique). À mettre sur le
# domaine en production. Vide = domaine de production Vercel, puis localhost.
# Les smoke tests lisent la variable GitHub PUBLIC_URL (Settings → Variables).
NEXT_PUBLIC_SITE_URL=

# Nœud Solana (mainnet). Ordre essayé : SOLANA_RPC_URL s'il est posé, sinon le
# nœud Solana de la clé Alchemy de RPC_URL, et toujours en dernier recours le
# nœud public https://api.mainnet-beta.solana.com (limité, ~3 appels/s, et qui
# ne sert pas getTokenLargestAccounts : les gros tokens y sont lus en partie).
#
# SOLANA_RPC_URL : URL complète d'un nœud Solana, une seule. Prioritaire.
SOLANA_RPC_URL=
# RPC_URL : URL Alchemy (https://<réseau>.g.alchemy.com/v2/<clé>). Si
# SOLANA_RPC_URL est vide, SEAL en tire la clé et lit Solana par
# solana-mainnet.g.alchemy.com. Le réseau Solana doit être activé dans l'app
# Alchemy : sinon le nœud refuse et /api/health répond 503 « degraded ».
RPC_URL=
# Appels par seconde vers le nœud à clé (SOLANA_RPC_URL ou Alchemy), en régime
# continu. Vide = 10. Le nœud public garde son propre débit, mesuré.
SEAL_SOLANA_RPC_RATE=

# --- Fournisseur de raisonnement ---
# Sans aucune clé, l'application fonctionne en mode hors-ligne : elle restitue
# les faits sans les croiser, et le dit. Tout le pipeline de données est gratuit.
#
# AGENT_PROVIDER : groq | anthropic | offline. Vide = le premier disponible,
# Groq en premier parce qu'il est gratuit.
AGENT_PROVIDER=

# Groq — gratuit, sans carte bancaire : https://console.groq.com/keys
# Tier gratuit : 30 req/min, 1 000 req/jour, 100k tokens/jour sur le 70B.
# Une analyse pèse ~6 700 tokens, soit ~14 analyses/jour.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — payant à l'usage : https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Agents composés (/api/agent) : le modèle suit la difficulté du rapport, pas
# ANTHROPIC_MODEL. Haiku 5.5 si rien n'est notable, Sonnet 5.5 au premier
# constat, Opus 5.5 quand les constats se contredisent.
#
# Fable 5.1 (~0,15 $ la restitution) n'est jamais choisi d'office : seulement si
# Opus a été rejeté sur un rapport à au moins deux conflits, ET si ce budget
# mensuel en dollars le couvre. Vide ou 0 = jamais.
SEAL_FRONTIER_BUDGET_USD=0

# DexScreener ne demande aucune clé (300 req/min)

# Signalement des erreurs (Sentry). Vide = rien n'est chargé ni envoyé.
# Le DSN se trouve dans Sentry : Settings → Projects → seal → Client Keys (DSN).
# Il n'est pas secret (il finit dans le navigateur). À mettre sur Vercel, en
# Production pour `seal` et `seal-staging`, puis redéployer (il est lu au build).
# Aucune IP, aucun cookie, aucun en-tête ni corps de requête n'est envoyé.
NEXT_PUBLIC_SENTRY_DSN=
