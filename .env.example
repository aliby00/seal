# Copier vers .env.local et remplir. .env.local est gitignoré.
# Ne jamais mettre de vraie valeur dans ce fichier.

# Environnement : development | staging | production
SEAL_ENV=development

# Robinhood Chain — RPC (chain ID 4663)
# Public (rate-limité) : https://rpc.mainnet.chain.robinhood.com
RPC_URL=
# Appels RPC par seconde, en régime continu. Le RPC public accepte une rafale
# d'environ 20 puis ~4/s (mesuré le 14/10/2026) ; un RPC payant permet de monter.
SEAL_RPC_RATE=

# Blockscout — clé obligatoire, gratuite sur https://dev.blockscout.com
# Tier gratuit : 5 req/s, 100 000 crédits/jour
BLOCKSCOUT_API_KEY=

# --- Fournisseur de raisonnement ---
# Sans aucune clé, l'application fonctionne en mode hors-ligne : elle restitue
# les faits sans les croiser, et le dit. Tout le pipeline de données est gratuit.
#
# AGENT_PROVIDER : groq | anthropic | offline. Vide = le premier disponible,
# Groq en premier parce qu'il est gratuit.
AGENT_PROVIDER=

# Groq — gratuit, sans carte bancaire : https://console.groq.com/keys
# Tier gratuit : 30 req/min, 1 000 req/jour, 100k tokens/jour sur le 70B.
# Une analyse pèse ~6 700 tokens, soit ~14 analyses/jour.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — payant à l'usage : https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Agents composés (/api/agent) : le modèle suit la difficulté du rapport, pas
# ANTHROPIC_MODEL. Haiku 5.5 si rien n'est notable, Sonnet 5.5 au premier
# constat, Opus 5.5 quand les constats se contredisent.
#
# Fable 5.1 (~0,15 $ la restitution) n'est jamais choisi d'office : seulement si
# Opus a été rejeté sur un rapport à au moins deux conflits, ET si ce budget
# mensuel en dollars le couvre. Vide ou 0 = jamais.
SEAL_FRONTIER_BUDGET_USD=0

# DexScreener ne demande aucune clé (300 req/min)
