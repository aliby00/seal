{
  "name": "seal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:guards": "vitest run tests/guards",
    "smoke": "node scripts/smoke.mjs",
    "probe:rpc": "node --experimental-strip-types scripts/probe-rpc.ts",
    "probe:dexscreener": "node --experimental-strip-types scripts/probe-dexscreener.ts",
    "probe:blockscout": "node --experimental-strip-types scripts/probe-blockscout.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.56.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
