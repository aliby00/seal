# Copier vers indexer/.env et remplir. .env est gitignoré.
# Ne jamais mettre de vraie valeur dans ce fichier.

# Jeton exigé par toutes les routes sauf /health (24 caractères au moins).
# Le même que INDEXER_TOKEN côté application. Exemple : openssl rand -hex 32
INDEXER_TOKEN=

# Nœud Robinhood Chain. Vide = nœud public (~4 requêtes/s).
RPC_URL=
# Requêtes eth_getLogs par seconde. 4 pour le nœud public.
RPC_RATE=4

# Clé Blockscout PRO (https://dev.blockscout.com). Vide = le financement des
# créateurs n'est pas lu, et /health le dit.
BLOCKSCOUT_API_KEY=
# Appels Blockscout par jour pour le financement. Le quota (100 000 crédits/jour
# en gratuit, ~20 par appel) est PARTAGÉ avec le site : rester bien en dessous.
FUNDING_DAILY_CALLS=2000

# Jours de swaps relus au premier démarrage (ensuite, la tête est suivie).
BACKFILL_DAYS=30

# Fixés par compose.yaml dans le conteneur ; utiles en local seulement.
# PORT=8795
# DB_PATH=/data/seal-indexer.db
